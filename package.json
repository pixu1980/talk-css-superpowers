{
  "name": "css-over-engineering",
  "version": "1.5.2",
  "license": "MIT",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist .parcel-cache",
    "dev": "pnpm run clean && parcel src/index.html -p 6001",
    "build": "pnpm run clean && parcel build src/index.html --no-optimize --public-url ./",
    "format": "prettier --write \"**/*.{md,yml,yaml}\" && biome check --write .",
    "lint": "prettier --check \"**/*.{md,yml,yaml}\" && biome check .",
    "deps": "pnpm up --latest --save-exact \"!sharp\"",
    "release": "release-it"
  },
  "dependencies": {
    "@pixu-talks/core": "workspace:*",
    "@pixu-talks/fonts": "workspace:*",
    "@pixu-talks/theme": "workspace:*",
    "reveal.js": "6.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@parcel/transformer-inline-string": "2.16.4",
    "@parcel/transformer-sass": "2.16.4",
    "@release-it/conventional-changelog": "12.0.2",
    "@swc/core": "1.16.22",
    "baseline-browser-mapping": "2.11.35",
    "lightningcss": "1.33.0",
    "parcel": "2.16.4",
    "posthtml": "0.16.7",
    "posthtml-include": "2.0.1",
    "prettier": "3.9.10",
    "release-it": "21.1.2",
    "sharp": "0.33.5",
    "svgo": "4.1.0"
  }
}
